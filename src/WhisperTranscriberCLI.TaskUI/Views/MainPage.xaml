<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="WhisperTranscriberCLI.TaskUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WhisperTranscriberCLI.TaskUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <Page.Resources>
        <Style TargetType="Button" x:Key="KeyboardShortcutStyle">
            <Setter Property="ToolTipService.ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenFiles_Invoked"/>
            <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="OpenFolder_Invoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveQueue_Invoked"/>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="LoadQueue_Invoked"/>
            <KeyboardAccelerator Key="F5" Invoked="StartQueue_Invoked"/>
            <KeyboardAccelerator Key="Pause" Invoked="PauseQueue_Invoked"/>
            <KeyboardAccelerator Key="Escape" Invoked="CancelQueue_Invoked"/>
            <KeyboardAccelerator Key="Delete" Invoked="DeleteTask_Invoked"/>
            <KeyboardAccelerator Key="Delete" Modifiers="Control,Shift" Invoked="DeleteQueue_Invoked"/>
            <KeyboardAccelerator Key="F1" Invoked="ShowHelp_Invoked"/>
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with controls -->
        <Grid Grid.Row="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- File and folder selection -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="AddFilesButton" Grid.Column="0" Content="Add Files..." Margin="0,0,8,0" Click="AddFilesButton_Click" ToolTipService.ToolTip="Add Files (Ctrl+O)"/>
                <Button x:Name="AddFolderButton" Grid.Column="1" Content="Add Folder..." Margin="0,0,8,0" Click="AddFolderButton_Click" ToolTipService.ToolTip="Add Folder (Ctrl+Shift+O)"/>
                <CheckBox x:Name="RecursiveCheckBox" Grid.Column="2" Content="Recursive" Margin="0,0,12,0" IsChecked="True" Checked="RecursiveCheckBox_Changed" Unchecked="RecursiveCheckBox_Changed"/>
                
                <TextBlock Grid.Column="3" Text="Model:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ModelComboBox" Grid.Column="4" Width="120" Margin="0,0,8,0" SelectionChanged="ModelComboBox_SelectionChanged"/>
                
                <TextBlock Grid.Column="5" Text="Language:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="LanguageComboBox" Grid.Column="6" Width="80" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="auto"/>
                    <ComboBoxItem Content="en"/>
                    <ComboBoxItem Content="es"/>
                    <ComboBoxItem Content="fr"/>
                    <ComboBoxItem Content="de"/>
                    <ComboBoxItem Content="it"/>
                    <ComboBoxItem Content="pt"/>
                    <ComboBoxItem Content="ru"/>
                    <ComboBoxItem Content="ja"/>
                    <ComboBoxItem Content="ko"/>
                    <ComboBoxItem Content="zh"/>
                </ComboBox>
                
                <TextBlock Grid.Column="7" Text="Acceleration:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="AccelerationComboBox" Grid.Column="8" Width="80" SelectedIndex="0" SelectionChanged="AccelerationComboBox_SelectionChanged">
                    <ComboBoxItem Content="CPU"/>
                    <ComboBoxItem Content="GPU"/>
                </ComboBox>
            </Grid>
            
            <!-- Output directory -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Output Dir:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="1" Margin="0,0,8,0" PlaceholderText="C:\audio\transcripts"/>
                <Button x:Name="BrowseOutputButton" Grid.Column="2" Content="Browse..." Click="BrowseOutputButton_Click"/>
            </Grid>
        </Grid>
        
        <!-- Task list -->
        <ListView x:Name="TaskListView" Grid.Row="2" Margin="12,0,12,12" SelectionMode="Single" RightTapped="TaskListView_RightTapped" AllowDrop="True" Drop="TaskListView_Drop" DragOver="TaskListView_DragOver">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="RemoveTaskMenuItem" Text="Remove" Icon="Delete" Click="RemoveTaskMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="RetryTaskMenuItem" Text="Retry" Icon="Refresh" Click="RetryTaskMenuItem_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="OpenOutputMenuItem" Text="Open Output" Icon="OpenFile" Click="OpenOutputMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="OpenFolderMenuItem" Text="Open Folder" Icon="OpenLocal" Click="OpenFolderMenuItem_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="CopyPathMenuItem" Text="Copy Path" Icon="Copy" Click="CopyPathMenuItem_Click"/>
                    <MenuFlyoutItem x:Name="ShowPropertiesMenuItem" Text="Properties" Icon="Setting" Click="ShowPropertiesMenuItem_Click"/>
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="File" FontWeight="SemiBold" Margin="8,4"/>
                    <TextBlock Grid.Column="1" Text="Duration" FontWeight="SemiBold" Margin="8,4"/>
                    <TextBlock Grid.Column="2" Text="Model" FontWeight="SemiBold" Margin="8,4"/>
                    <TextBlock Grid.Column="3" Text="Lang" FontWeight="SemiBold" Margin="8,4"/>
                    <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" Margin="8,4"/>
                    <TextBlock Grid.Column="5" Text="Progress" FontWeight="SemiBold" Margin="8,4"/>
                </Grid>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Margin="8,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Duration}" Margin="8,4"/>
                        <TextBlock Grid.Column="2" Text="{Binding ModelName}" Margin="8,4"/>
                        <TextBlock Grid.Column="3" Text="{Binding Language}" Margin="8,4"/>
                        <TextBlock Grid.Column="4" Text="{Binding Status}" Margin="8,4"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,4">
                            <ProgressBar Value="{Binding Progress}" Maximum="100" Width="100" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Progress}" VerticalAlignment="Center" FontSize="11" Width="35" TextAlignment="Right"/>
                            <TextBlock Text="%" VerticalAlignment="Center" FontSize="11" Width="10"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        
        <!-- Queue controls -->
        <Grid Grid.Row="3" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartQueueButton" Content="▶ Start Queue" Click="StartQueueButton_Click" ToolTipService.ToolTip="Start Queue (F5)"/>
                <Button x:Name="PauseQueueButton" Content="⏸ Pause" Click="PauseQueueButton_Click" ToolTipService.ToolTip="Pause Queue (Pause)"/>
                <Button x:Name="CancelCurrentButton" Content="⏹ Cancel Current" Click="CancelCurrentButton_Click" ToolTipService.ToolTip="Cancel Queue (Esc)"/>
                <Button x:Name="ClearDoneButton" Content="🗑 Clear Done" Click="ClearDoneButton_Click" ToolTipService.ToolTip="Clear Completed Tasks"/>
                <Button x:Name="DeleteQueueButton" Content="❌ Delete Queue" Click="DeleteQueueButton_Click" ToolTipService.ToolTip="Delete All Tasks (Ctrl+Shift+Delete)"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveQueueButton" Content="💾 Save Queue" Click="SaveQueueButton_Click" ToolTipService.ToolTip="Save Queue (Ctrl+S)"/>
                <Button x:Name="LoadQueueButton" Content="📁 Load Queue" Click="LoadQueueButton_Click" ToolTipService.ToolTip="Load Queue (Ctrl+L)"/>
                <Button x:Name="SettingsButton" Content="🔧 Settings" Click="SettingsButton_Click"/>
                <Button x:Name="AboutButton" Content="? About" Click="AboutButton_Click" ToolTipService.ToolTip="About (F1)"/>
            </StackPanel>
        </Grid>
        
        <!-- Status bar -->
        <Grid Grid.Row="4" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="12,8">
            <TextBlock x:Name="StatusTextBlock" Text="Ready" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>